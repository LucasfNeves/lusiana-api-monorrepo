{
  "name": "lusiana-api-monorrepo",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "dev": "nest start --watch",
    "dev:debug": "tsx watch --inspect src/main/main.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:integration:watch": "vitest --project integration",
    "test:cov": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "validate": "pnpm lint && pnpm typecheck && pnpm test:ci",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "docker:up": "docker compose -f docker/compose.yml --env-file .env up -d",
    "docker:down": "docker compose -f docker/compose.yml --env-file .env down",
    "docker:down:volumes": "docker compose -f docker/compose.yml --env-file .env down -v",
    "docker:stop": "docker compose -f docker/compose.yml --env-file .env stop",
    "docker:logs": "docker compose -f docker/compose.yml --env-file .env logs -f",
    "docker:ps": "docker compose -f docker/compose.yml --env-file .env ps",
    "docker:db:psql": "docker compose -f docker/compose.yml --env-file .env exec database sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "docker:reset": "docker compose -f docker/compose.yml --env-file .env down -v && docker compose -f docker/compose.yml --env-file .env up -d",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": "prettier --write"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1173.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nestjs": "^11.1.0",
    "better-auth": "1.7.26",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.11",
    "auth": "1.7.26",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
