NODE_ENV=development
# 3000 (decidido em 2026-11-20): o lusiana-estoque usa a 3001 e o lusiana-search a 3002; o front precisa de outra porta.
PORT=3000

# http
# Origens permitidas pelo CORS, separadas por virgula. Nunca use "*" junto de
# credentials: o navegador recusa, e refletir a origem abriria CSRF.
CORS_ORIGIN=http://localhost:3000

# better auth
# Gere com: openssl rand -base64 32 (minimo de 32 caracteres).
BETTER_AUTH_SECRET=
# Endereco publico da API: o Better Auth monta com ele as URLs de retorno (Google, e-mails).
BETTER_AUTH_URL=http://localhost:3000
# Pepper das senhas: chave secreta do Argon2, fora do banco. Gere com: openssl rand -base64 32.
# Nunca troque nem perca este valor: as senhas ja cadastradas deixam de conferir.
PASSWORD_PEPPER=

# Login com Google: "true" ou "false". Com "true", o ID e o segredo sao obrigatorios.
# URL de retorno a cadastrar no Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_ENABLE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry: sem DSN, o SDK nao envia nada.
SENTRY_DSN=

# database
POSTGRES_PASSWORD=lusiana
POSTGRES_USER=lusiana
POSTGRES_DB=lusiana
# 5435: os outros projetos usam da 5432 a 5434.
POSTGRES_PORT=5435
# Escrita por extenso: o dotenv do prisma.config.ts nao expande ${...}.
DATABASE_URL=postgresql://lusiana:lusiana@localhost:5435/lusiana
